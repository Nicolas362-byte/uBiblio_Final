<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="laporan_buku"
              pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30"
              topMargin="30" bottomMargin="30"
              whenNoDataType="NoDataSection">

    <parameter name="tanggalCetak" class="java.lang.String"/>
    <parameter name="totalBuku" class="java.lang.Integer"/>

    <field name="isbn" class="java.lang.String"/>
    <field name="judul" class="java.lang.String"/>
    <field name="penulis" class="java.lang.String"/>
    <field name="genre" class="java.lang.String"/>

    <title>
        <band height="82">
            <staticText>
                <reportElement x="0" y="0" width="535" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[LAPORAN DATA BUKU uBiblio]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="38" width="100" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Tanggal cetak:]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="38" width="250" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{tanggalCetak}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="350" y="38" width="185" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Total buku: " + $P{totalBuku}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="70" width="535" height="1"/>
            </line>
        </band>
    </title>

    <columnHeader>
        <band height="28">
            <staticText>
                <reportElement mode="Opaque" backcolor="#DCE6F1" x="0" y="0" width="85" height="28"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[ISBN]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#DCE6F1" x="85" y="0" width="190" height="28"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[JUDUL BUKU]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#DCE6F1" x="275" y="0" width="155" height="28"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[PENULIS]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#DCE6F1" x="430" y="0" width="105" height="28"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[GENRE]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="25">
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="0" width="85" height="25"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{isbn}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="85" y="0" width="190" height="25"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{judul}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="275" y="0" width="155" height="25"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{penulis}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="430" y="0" width="105" height="25"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{genre}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <noData>
        <band height="35">
            <staticText>
                <reportElement x="0" y="5" width="535" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isItalic="true"/>
                </textElement>
                <text><![CDATA[Belum ada data buku untuk ditampilkan.]]></text>
            </staticText>
        </band>
    </noData>

    <pageFooter>
        <band height="25">
            <textField>
                <reportElement x="435" y="5" width="100" height="15"/>
                <textElement textAlignment="Right"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA["Halaman " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
